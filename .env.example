# =============================================================================
# realtime-translator 環境変数サンプル
# -----------------------------------------------------------------------------
# 使い方: このファイルを .env.local にコピーして実値を入れる。
#   cp .env.example .env.local
# 絶対ルール:
#   - .env.local は git にコミットしない（.gitignore 済みを確認）。
#   - 秘密情報に NEXT_PUBLIC_ を付けない（付けるとブラウザに露出する）。
#   - OPENAI_API_KEY はサーバー（API route）でのみ使用。ブラウザに渡さない。
# =============================================================================

# --- OpenAI（サーバー専用・絶対にブラウザへ出さない） ---
# 標準 API key。client secret 発行 API route 内でのみ使用する。
OPENAI_API_KEY=sk-REPLACE_ME

# 使用する翻訳モデル（英→日 リアルタイム翻訳）。
OPENAI_REALTIME_MODEL=gpt-realtime-translate

# 出力言語 / 入力言語（翻訳セッション設定に使用）。
TRANSLATE_SOURCE_LANG=en
TRANSLATE_TARGET_LANG=ja

# client secret の有効期限（秒）。10〜7200 の範囲。短いほど安全。
REALTIME_CLIENT_SECRET_TTL_SECONDS=120

# --- 認証（Auth.js / NextAuth v5） ---
# `openssl rand -base64 32` などで生成したランダム値。
AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# OAuth プロバイダ（例: Google）。値は各プロバイダのコンソールから取得。
AUTH_GOOGLE_ID=REPLACE_ME
AUTH_GOOGLE_SECRET=REPLACE_ME

# --- 認可（許可メール allowlist） ---
# 利用を許可するメールアドレス。カンマ区切り。ここに無いユーザーは 403 相当で拒否。
ALLOWED_EMAILS=ofarm.h.u@gmail.com

# --- アプリ設定 ---
# 本番 URL（cookie / CORS / リダイレクトに使用）。
AUTH_URL=http://localhost:3000

# Safety Identifier に使う値の生成元シークレット（メールを直接送らずハッシュ化する用途）。
SAFETY_ID_SALT=REPLACE_WITH_RANDOM_VALUE
